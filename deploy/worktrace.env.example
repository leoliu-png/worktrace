# Copy this file to /opt/worktrace/.env on the server and replace every secret.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
KEY_ENCRYPTION_SECRET=
ADMIN_EMAILS=linden@feedmob.com,leo_liu@feedmob.com
AUTH_URL=https://worktrace.techmob.net
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://worktrace.techmob.net
LOCAL_DATABASE_PATH=/var/lib/worktrace/worktrace.db
WORKTRACE_UPLOAD_DIR=/var/lib/worktrace/uploads
MOBIUS_MCP_URL=https://mobius.feedmob.com/api/mcp
MOBIUS_PAT=
MOBIUS_SYNC_AUTHOR_EMAILS=
MOBIUS_MATCHER=jev
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_MIN_PROBABILITY=0.75
JEV_MIN_CONFIDENCE=0.70
JEV_MIN_MARGIN=0.20
